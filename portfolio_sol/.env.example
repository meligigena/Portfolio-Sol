# Public frontend configuration. Add these four variables to Vercel Production.
# Their values may be included in the Vite browser bundle.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_STORAGE_BUCKET=portfolio-media
# Keep false locally only when testing the fallback; use true in Production.
VITE_PORTFOLIO_DATABASE_ENABLED=false

# Local migration scripts only. Never configure these in the Vercel frontend.
# Keep their real values exclusively in the gitignored .env.migration file.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
